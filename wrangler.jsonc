{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krishlankatours",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Lets the memory queue call back into this Worker to revalidate pages.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "krishlankatours" }
  ],

  // ISR / SSG page cache (incremental cache).
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "cc88fe3844d14de29dc05275653cd0a1" }
  ],

  // revalidatePath()/revalidateTag() timestamps.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "krishlankatours-tag-cache",
      "database_id": "d2018d6b-fd26-4ca1-b8a3-894aebf965e4"
    }
  ]
}
