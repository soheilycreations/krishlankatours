# Copy to .env.local (for `npm run dev`) and to .env.production.local (for
# `npm run preview` / `npm run deploy` from your own computer).
# Both files are git-ignored. See CLOUDFLARE-DEPLOY.md.

# --- Build variables (inlined into the site at BUILD time) -----------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Canonical domain used in canonical/hreflang tags, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://krishlankatours.com

# --- Runtime (Cloudflare secret: `npx wrangler secret put ADMIN_EMAILS`) ----
# Only used until supabase/migration-5-hardening.sql has been run; after that
# the admin list lives in the admin_users table. Comma-separated.
# ADMIN_EMAILS=krishlankatours@gmail.com
